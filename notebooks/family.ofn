Prefix(:=<http://example.org/family#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<http://example.org/family>
Declaration(Class(:Father))
Declaration(Class(:Mother))
Declaration(Class(:Male))
Declaration(Class(:Female))
Declaration(Class(:Parent))
Declaration(Class(:Child))
Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasChild))
AnnotationAssertion(rdfs:label :Father "father")
AnnotationAssertion(rdfs:label :Mother "mother")
AnnotationAssertion(rdfs:label :Male "male")
AnnotationAssertion(rdfs:label :Female "female")
AnnotationAssertion(rdfs:label :Parent "parent")
AnnotationAssertion(rdfs:label :Child "child")
AnnotationAssertion(rdfs:label :hasParent "has parent")
AnnotationAssertion(rdfs:label :hasChild "has child")
SubClassOf(:Father ObjectIntersectionOf(:Male :Parent))
SubClassOf(:Mother ObjectIntersectionOf(:Female :Parent))
SubClassOf(ObjectIntersectionOf(:Male :Parent) :Father)
SubClassOf(ObjectIntersectionOf(:Female :Parent) :Mother)
DisjointClasses(:Male :Female)
DisjointClasses(:Parent :Child)
SubClassOf(:Child ObjectSomeValuesFrom(:hasParent :Mother))
SubClassOf(:Child ObjectSomeValuesFrom(:hasParent :Father))
SubClassOf(:Parent ObjectSomeValuesFrom(:hasChild :Child))
)
